PORT=5000
NODE_ENV=development
MONGODB_URI=<your-mongodb-atlas-connection-string>
CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=<long-random-secret-for-signing-authentication-tokens>
OTP_HASH_SECRET=<different-long-random-secret-for-hashing-otp-values>

# To use SMTP, uncomment and replace all five values. In local development,
# leave them unset to use the development-only console OTP mode.
# SMTP_HOST=<your-smtp-host>
# SMTP_PORT=<your-smtp-port>
# SMTP_USER=<your-smtp-username>
# SMTP_PASS=<your-smtp-password>
# EMAIL_FROM=<verified-sender-email-address>
